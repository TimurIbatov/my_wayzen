{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "seed": "node --env-file-if-exists=../../.env ./src/seed.mjs",
    "push": "node --env-file-if-exists=../../.env ../../node_modules/drizzle-kit/bin.cjs push --config ./drizzle.config.ts",
    "push-force": "node --env-file-if-exists=../../.env ../../node_modules/drizzle-kit/bin.cjs push --force --config ./drizzle.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.23.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10"
  }
}
