# WayZen local / cloud env placeholders — copy to `.env` and fill secrets via
# Cursor environment secrets (do not paste keys into chat).
# Root `.env` is loaded by API (`npm run start`) and db scripts when present
# (`node --env-file-if-exists`). Vite also loads `.env` / `.env.local` for VITE_*.

# Postgres (local example shape — replace USER/PASSWORD/HOST for your instance)
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/wayzen

# API
PORT=5055
SESSION_SECRET=replace-with-long-random-string
NODE_ENV=development
# LOG_LEVEL=info

# Frontend (Vite) — override PORT when starting the SPA:
#   PORT=5173 BASE_PATH=/ npm run dev -w @workspace/wayzen
# PORT=5173
BASE_PATH=/
# Optional: Vite /api proxy target (default http://127.0.0.1:5055)
# API_PROXY_TARGET=http://127.0.0.1:5055

# Gemini (WayZen AI chat + routes) — set as environment secret
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite

# Clerk (auth) — set as environment secrets; publishable + secret must match one app
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# VITE_CLERK_PROXY_URL=

# Comma-separated Clerk user IDs allowed to use /admin/places
# WAYZEN_ADMIN_USER_IDS=

# Optional Stripe Trip Pass
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_TRIP_PASS_PRICE_ID=price_...
# STRIPE_SUCCESS_URL=http://localhost:5173/profile
# STRIPE_CANCEL_URL=http://localhost:5173/profile
# STRIPE_TRIP_PASS_DAYS=365
# PUBLIC_APP_URL=http://localhost:5173

# Optional feature / storage
# OFFLINE_MAPS_ENABLED=false
# PRIVATE_OBJECT_DIR=
# PUBLIC_OBJECT_SEARCH_PATHS=
